--- /dev/null
+++ b/node_modules/@react-navigation/drawer/src/views/modern/useAnimatedGestureHandlerCompat.js
@@ -0,0 +1,21 @@
+import { useEvent, useHandler } from 'react-native-reanimated';
+const S = { UNDETERMINED: 0, FAILED: 1, BEGAN: 2, CANCELLED: 3, ACTIVE: 4, END: 5 };
+export function useAnimatedGestureHandler(handlers, dependencies) {
+  const { context, doDependenciesDiffer } = useHandler(handlers, dependencies);
+  return useEvent(
+    (event) => {
+      'worklet';
+      const { onStart, onActive, onEnd, onFail, onCancel, onFinish } = handlers;
+      if (event.state === S.BEGAN && onStart) onStart(event, context);
+      if (event.state === S.ACTIVE && onActive) onActive(event, context);
+      if (event.oldState === S.ACTIVE && event.state === S.END && onEnd) onEnd(event, context);
+      if (event.oldState === S.ACTIVE && event.state === S.FAILED && onFail) onFail(event, context);
+      if (event.oldState === S.ACTIVE && event.state === S.CANCELLED && onCancel) onCancel(event, context);
+      if (event.oldState === S.ACTIVE && (event.state === S.END || event.state === S.FAILED || event.state === S.CANCELLED) && onFinish) {
+        onFinish(event, context, event.state === S.CANCELLED || event.state === S.FAILED);
+      }
+    },
+    ['onGestureHandlerStateChange', 'onGestureHandlerEvent'],
+    doDependenciesDiffer
+  );
+}
