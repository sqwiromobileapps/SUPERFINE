{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "importHelpers": true,
    "allowJs": true,
    "checkJs": false,
    "module": "ES2020",
    "moduleResolution": "node",
    "typeRoots": [
      "typings",
      "node_modules/@types",
      "node_modules/@expocraft-icons"
    ],
    "baseUrl": "./src",
    "lib": ["es2017"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@cloudhub-ux/graphql": ["./node_modules/@cloudhub-ux/graphql"],
      "@expocraft/core": ["/Users/bernardgaitho/@cloudhub/@expocraft/core"],
      "@sqwiro/app": ["./@sqwiro/app"],
      "@sqwiro/appcore": ["./@sqwiro/appcore"],
      "@sqwiro/customapps": ["./@sqwiro/customapps"],
      "@sqwiro/businessapps": ["./@sqwiro/businessapps"],
      "@sqwiro/userapps": ["./@sqwiro/userapps"],
      "@sqwiro/customuserapps": ["./@sqwiro/customuserapps"]
    },
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "preserveSymlinks": false,
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["./src/**/*", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts",
    "node_modules",
    "dist",
    "build",
    ".next",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/node_modules/**",
    "**/dist/**",
    "src/**/*.json",
    "src/libraries/cloudhub-ux/mockdata/**/*.json"
  ]
}
