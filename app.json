{
  "name": "SUPERFINE",
  "platforms": [
    "ios",
    "android"
  ],
  "icon": "./src/@sqwiro/app/assets/images/logoicon.png",
  "splash": {
    "image": "./src/@sqwiro/app/assets/images/splash.png",
    "resizeMode": "cover",
    "backgroundColor": "#FDE3D7"
  },
  "expo": {
    "name": "SUPERFINE",
    "slug": "SUPERFINE",
    "userInterfaceStyle": "automatic",
    "packagerOpts": {
      "host": "admin.localsuperfine.com"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/@sqwiro/app/assets/images/logoicon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow superfine to access your microphone."
        }
      ],
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "androidExtensions": {
            "useExoplayerIMA": true,
            "useExoplayerRtsp": true,
            "useExoplayerSmoothStreaming": true,
            "useExoplayerHls": true,
            "useExoplayerDash": true,
            "extensionRendererMode": "prefer"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video",
      "expo-audio"
    ],
    "android": {
      "icon": "./src/@sqwiro/app/assets/images/logoicon.png",
      "package": "com.superfineafrica.cloud",
      "adaptiveIcon": {
        "backgroundColor": "#FDE3D7"
      },
      "splash": {
        "image": "./src/@sqwiro/app/assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#FDE3D7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "ios": {
      "icon": "./src/@sqwiro/app/assets/images/logoicon.png",
      "bundleIdentifier": "com.superfineafrica.cloud",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera and image gallery to update profile images and upload documents/images.",
        "NSMicrophoneUsageDescription": "This app uses the audio device to record short vides that can be uploaded to profiles for describing certain questions",
        "NSContactsUsageDescription": "This app uses the phone contacts to help user easily select a contact from contacts list",
        "NSPhotoLibraryUsageDescription": "This app uses the camera and image gallery to update profile images and upload documents/images.",
        "NSLocationWhenInUseUsageDescription": "This app uses location to authenticate that users are indeed in the location they claim to be ",
        "NSPrivacyAccessedAPICategoryFileTimestamp": "The app uses the file timestamp to determine the time the file was last modified",
        "NSPrivacyAccessedAPICategoryUserDefaults": "The app uses the user defaults to store user data for personalization",
        "NSPrivacyAccessedAPICategorySystemBootTime": "The app may use the system boot time to determine the time the app was last used",
        "NSPrivacyAccessedAPICategoryDiskSpace": "The app uses the file system to store user data and images. Disk information may be required to show user how much space is available"
      },
      "splash": {
        "image": "./src/@sqwiro/app/assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#FDE3D7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "171184dd-6b7e-40b9-b32e-6542aa76a74d"
      }
    },
    "updates": {
      "requestHeaders": {
        "expo-runtime-version": "1.0.0",
        "expo-channel-name": "sdk56"
      },
      "url": "https://u.expo.dev/171184dd-6b7e-40b9-b32e-6542aa76a74d"
    },
    "newArchEnabled": true
  }
}
